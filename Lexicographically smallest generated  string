class Solution:
    def generateString(self, str1, str2):
        n,m=len(str1),len(str2)
        res=['']*(n+m-1)
        fixed=[False]*(n+m-1)
        for i in range(n):
            if str1[i]=='T':
                for j in range(m):
                    if res[i+j] and res[i+j]!=str2[j]:
                        return ""
                    res[i+j]=str2[j]
                    fixed[i+j]=True
        for i in range(n+m-1):
            if res[i]=='':
                res[i]='a'
        for i in range(n):
            if str1[i]=='F':
                if ''.join(res[i:i+m])==str2:
                    for j in range(m-1,-1,-1):
                        if not fixed[i+j]:
                            res[i+j]='b'
                            break
                    else:
                        return ""
        return ''.join(res)
